# Base des routes REST du core, derrière la gateway (inclut /api/v1).
# Pas de proxy Metro comme le proxy Vite en dev — pointer directement sur la gateway :
#
#   Simulateur iOS      : http://localhost:8080/api/v1   (partage le réseau de l'hôte)
#   Émulateur Android    : http://10.0.2.2:8080/api/v1    (alias loopback hôte)
#   Device physique (Expo Go, même Wi-Fi que ce PC) : http://<IP-LAN-du-PC>:8080/api/v1
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
