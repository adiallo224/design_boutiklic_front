{
  "expo": {
    "name": "BOUTIKLIC",
    "slug": "boutiklic-mobile",
    "description": "Ma boutique dans ma poche",
    "scheme": "boutiklicmobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "package": "com.anonymous.boutiklicmobile"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Autoriser BOUTIKLIC à utiliser l'appareil photo pour scanner les codes-barres"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Autoriser BOUTIKLIC à utiliser votre position pour localiser la boutique"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "73ede773-0b7a-4aaa-869b-7e5bfb828f96"
      }
    }
  }
}
