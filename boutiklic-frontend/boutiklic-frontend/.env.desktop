# Utilisé uniquement par le build packagé de boutiklic-desktop (tauri build --mode desktop),
# jamais par le web (qui reste en '/api', proxied par nginx en prod, cf. apiClient.ts).
# Valeur publique (URL d'API), pas un secret — committée volontairement pour un build reproductible.
# Doit inclure /api/v1 : le web passe par Caddy (/api -> /api/v1), le desktop appelle la gateway en direct.
VITE_API_BASE_URL=https://api.boutiklic.com/api/v1
